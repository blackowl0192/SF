DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30
ABS_MIN_FUNDING_RATE=0.0003
DEFAULT_FUNDING_INTERVAL_HOURS=8
ANALYTICS_OBSERVATION_ONLY=true
WINDOW_CACHE_MINUTES=120
DEFAULT_METRICS_WINDOW=60
LOG_LEVEL=INFO
NORMAL_SNAPSHOT_INTERVAL_SECONDS=60
FUNDING_WINDOW_BEFORE_SECONDS=600
FUNDING_WINDOW_AFTER_SECONDS=300
DETAILED_SNAPSHOT_INTERVAL_SECONDS=1
CONFIRMATION_INITIAL_DELAY_SECONDS=10
CONFIRMATION_RETRY_SECONDS=10
CONFIRMATION_MAX_ATTEMPTS=6
REST_TIMEOUT_SECONDS=10
WS_MAX_RECONNECT_DELAY_SECONDS=60
